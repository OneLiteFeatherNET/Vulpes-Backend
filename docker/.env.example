# Settings for the containers in docker/compose.yml.
#
#   cp docker/.env.example docker/.env
#
# The copy has to sit next to compose.yml: Compose looks for .env in the directory of the
# compose file, not in the directory it is run from, and a .env in the repository root is
# silently ignored. Compose reads it by itself. The backend does NOT: it runs through
# ./gradlew run, outside Compose, and takes its own settings from
# src/main/resources/application-local.yml. Keeping the two apart means neither can
# drift into disagreeing with the other about the same value.
#
# Every entry below has a working default in compose.yml, so an empty .env is fine.

# --- PostgreSQL -------------------------------------------------------------------
# Must match datasources.default in application-local.yml.
POSTGRES_DB=vulpesdb
POSTGRES_USER=vulpes
POSTGRES_PASSWORD=vulpespassword
POSTGRES_PORT=5432

# --- Keycloak (only with `docker compose --profile keycloak up`) -------------------
# The admin account for the console at http://localhost:8081/admin. Local only; these
# credentials never leave your machine.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The port the realm is served on. Changing it means changing the issuer and JWKS URL in
# application-local.yml to match -- the issuer in a token has to equal the configured one
# exactly, port included, or every request is refused.
KEYCLOAK_PORT=8081
