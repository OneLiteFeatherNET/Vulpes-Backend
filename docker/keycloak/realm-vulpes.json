{
  "realm": "vulpes",
  "enabled": true,
  "displayName": "Vulpes (local development)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "vulpes-backend",
      "name": "Vulpes Backend (the audience, not a login client)",
      "description": "Exists so tokens can name this API in their 'aud' claim. It never performs a login; the backend only validates tokens addressed to it.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "vulpes-ui-local",
      "name": "Stelaris UI (local)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:18080/*", "http://localhost:8085/*"],
      "webOrigins": ["http://localhost:18080", "http://localhost:8085"],
      "protocolMappers": [
        {
          "name": "vulpes-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vulpes-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "email": "developer@vulpes.local",
      "credentials": [
        {
          "type": "password",
          "value": "developer",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-vulpes"]
    }
  ]
}
